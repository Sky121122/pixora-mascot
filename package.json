{
  "name": "pixora-mascot",
  "version": "1.0.1",
  "description": "Interactive sprite-based mascots for React applications",
  "main": "dist/pixora-mascot.umd.cjs",
  "module": "dist/pixora-mascot.js",
  "style": "dist/pixora-mascot.css",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/pixora-mascot.js",
